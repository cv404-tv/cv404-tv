{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cv404-tv",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-14",
  "workers_dev": true,
  "dev": { "ip": "127.0.0.1", "port": 8787, "host": "127.0.0.1:8787" },
  "vars": {
    "AUTH_ORIGIN": "https://cv404.tv",
    "AUTH_EMAIL_FROM": "login@cv404.tv",
    "ADMIN_EMAILS": "kinggreenhall@gmail.com"
  },
  "d1_databases": [{
    "binding": "AUTH_DB",
    "database_name": "cv404-accounts",
    "database_id": "43ecf057-06a2-4953-89b4-fdb8acf8c830",
    "migrations_dir": "migrations"
  }],
  "send_email": [{ "name": "EMAIL", "allowed_sender_addresses": ["login@cv404.tv"] }],
  "triggers": { "crons": ["17 * * * *"] },
  "routes": [{ "pattern": "cv404.tv", "custom_domain": true }],
  "assets": {
    "binding": "ASSETS",
    "directory": "./out",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*", "/tier-list", "/tier-list/*"],
  },
  "durable_objects": {
    "bindings": [{ "name": "TIER_SNAPSHOTS", "class_name": "TierSnapshot" }],
  },
  "migrations": [{ "tag": "tier-snapshots-v1", "new_sqlite_classes": ["TierSnapshot"] }],
  "ratelimits": [{ "name": "SHARE_LIMITER", "namespace_id": "40401", "simple": { "limit": 30, "period": 60 } }],
}
