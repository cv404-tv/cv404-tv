{
  "name": "cv404-tv",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:api": "node scripts/test-tier-api.mjs",
    "dev": "next dev --hostname 127.0.0.1 --port 3000",
    "build": "next build && node scripts/postbuild.mjs",
    "preview": "wrangler dev --port 8787",
    "dev:worker": "npm run build && wrangler dev --port 8787",
    "deploy": "node scripts/check-auth-deploy.mjs && npm run build && wrangler deploy",
    "deploy:check": "npm run build && wrangler deploy --dry-run"
  },
  "devDependencies": {
    "wrangler": "^4.0.0",
    "miniflare": "5.20260911.1-alpha"
  },
  "dependencies": {
    "next": "^16.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.0"
  }
}
